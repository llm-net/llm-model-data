{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "purpose": {
            "enum": [
              "models",
              "pricing",
              "subscription",
              "billing",
              "discovery"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "url",
          "purpose",
          "notes"
        ]
      },
      "minItems": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "excluded_request_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "用户明确排除的请求ID，自动更新不得重新加入"
    }
  },
  "required": [
    "schema_version",
    "id",
    "display_name",
    "sources",
    "notes"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider source registry v1"
}
